# Puerto del servidor Express
PORT=3000

# Cadena de conexión a MongoDB (auth_db es el nombre de la base de datos).
# En local usa MongoDB instalado. En producción (Render) usa la de Atlas: Connect > Compass,
# reemplazando <db_username>, <db_password> y <tu-cluster> sin los < >:
#   mongodb+srv://<db_username>:<db_password>@<tu-cluster>.mongodb.net/auth_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/auth_db

# Clave para firmar y verificar los JWT. Genera una propia: openssl rand -hex 32
JWT_SECRET=cambia-esta-clave-por-una-aleatoria-de-64-caracteres
# Tiempo de vida del token (formato de jsonwebtoken: 15m, 1h, 1d)
JWT_EXPIRES_IN=1h

# Rondas de sal para bcrypt
BCRYPT_SALT_ROUNDS=10

# Administrador inicial que crea seedUsers al arrancar (solo si el email no existe).
# La contraseña debe cumplir la política: 8+ caracteres, mayúscula, dígito y # $ % & * @.
# Va entre comillas: sin ellas dotenv toma el # como inicio de un comentario.
ADMIN_EMAIL=admin@lab07.pe
ADMIN_PASSWORD="Cambia#Esta1"
ADMIN_NAME=Administrador
ADMIN_LASTNAME=Principal
ADMIN_PHONE=999000000
ADMIN_BIRTHDATE=1990-01-01
